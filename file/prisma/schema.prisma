generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  files File[]
}

model GoogleAccount {
  id String @id @default(cuid())

  googleId String  @unique
  email    String  @unique
  name     String?
  picture  String?

  refreshToken String
  accessToken  String?

  totalStorage BigInt?
  usedStorage  BigInt?

  isActive Boolean @default(true)
  priority Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files File[] @relation("GoogleAccountFiles")
}

model File {
  id           String  @id @default(cuid())
  name         String
  originalName String
  mimeType     String
  size         BigInt
  driveFileId  String
  folder       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  googleAccountId String
  googleAccount   GoogleAccount @relation("GoogleAccountFiles", fields: [googleAccountId], references: [id])
}
