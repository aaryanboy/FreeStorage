# Supabase Connection URL (IPv4-only transaction mode pooler)
DATABASE_URL="postgresql://postgres.[username]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true"

# Supabase Direct Connection URL (session mode, for migrations)
DIRECT_URL="postgresql://postgres.[username]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# App Configuration
# Optional: If specified, this will be used for OAuth callback. Otherwise, it will build dynamically from the host header.
NEXTAUTH_URL="http://localhost:3000"
